# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Analytics
# Google Analytics 4 measurement ID (build time). Production mobtranslate.com uses G-RTRR10NJNV;
# leave unset on clones/self-hosted deployments so they do not report to that property.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Optional: Feature Flags
NEXT_PUBLIC_ENABLE_CHAT=true
NEXT_PUBLIC_ENABLE_LEARNING=true
NEXT_PUBLIC_ENABLE_LEADERBOARD=true