{
  "name": "styleguide",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/generate-tokens.mjs && node scripts/generate-examples.mjs && next dev -p 3003",
    "build": "node scripts/generate-tokens.mjs && node scripts/generate-examples.mjs && next build",
    "start": "next start -p 3003",
    "lint": "eslint . --cache --cache-location .cache/eslint/.eslintcache --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:browser": "node --test tests/browser.test.mjs",
    "test:communication": "node --test tests/communication.test.mjs",
    "test:containment": "node --test tests/containment.test.mjs",
    "test:selection": "node --test tests/selection.test.mjs",
    "test:routes": "node scripts/check-routes.mjs",
    "tokens:generate": "node scripts/generate-tokens.mjs",
    "tokens:check": "node scripts/generate-tokens.mjs --check",
    "examples:generate": "node scripts/generate-examples.mjs",
    "examples:check": "node scripts/generate-examples.mjs --check",
    "test:inputs": "node --test tests/inputs.test.mjs",
    "test:menus": "node --test tests/menus.test.mjs",
    "test:navigation-controls": "node --test tests/navigation-controls.test.mjs",
    "test:destinations": "node --test tests/destinations.test.mjs",
    "test:adaptive-navigation": "node --test tests/adaptive-navigation.test.mjs",
    "test:select": "node --test tests/select.test.mjs",
    "test:autocomplete": "node --test tests/autocomplete.test.mjs",
    "test:combobox": "node --test tests/combobox.test.mjs",
    "test:date-time": "node --test tests/date-time.test.mjs",
    "test:disclosure": "node --test tests/disclosure.test.mjs",
    "test:rating": "node --test tests/rating.test.mjs",
    "test:stepper": "node --test tests/stepper.test.mjs",
    "test:layout-utilities": "node --test tests/layout-utilities.test.mjs",
    "test:avatar": "node --test tests/avatar.test.mjs",
    "test:scroll-area": "node --test tests/scroll-area.test.mjs",
    "test:preview-card": "node --test tests/preview-card.test.mjs",
    "test:table": "node --test tests/table.test.mjs",
    "test:material-patterns": "node --test tests/material-patterns.test.mjs",
    "test:governed-patterns": "node --test tests/governed-patterns.test.mjs"
  },
  "dependencies": {
    "@mobtranslate/ui": "workspace:*",
    "next": "^16.2.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.1",
    "@types/node": "26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "postcss": "8.5.15",
    "tailwindcss": "4.3.1",
    "typescript": "6.0.3"
  }
}
