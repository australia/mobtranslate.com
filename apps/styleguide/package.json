{
  "name": "styleguide",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @mobtranslate/ui tokens:check && node scripts/generate-tokens.mjs && node scripts/generate-alternative-fixture.mjs --check && node scripts/generate-color-fixture.mjs --check && node scripts/check-font-fixture.mjs && node scripts/generate-examples.mjs && node scripts/generate-api-reference.mjs && next dev -p 3003",
    "build": "pnpm --filter @mobtranslate/ui tokens:check && node scripts/generate-tokens.mjs && node scripts/generate-alternative-fixture.mjs --check && node scripts/generate-color-fixture.mjs --check && node scripts/check-font-fixture.mjs && node scripts/generate-examples.mjs && node scripts/check-glossary.mjs && node scripts/generate-api-reference.mjs && next build",
    "start": "next start -p 3003",
    "lint": "eslint . --cache --cache-location .cache/eslint/.eslintcache --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:browser": "node --test tests/browser.test.mjs",
    "test:communication": "node --test tests/communication.test.mjs",
    "test:containment": "node --test tests/containment.test.mjs",
    "test:selection": "node --test tests/selection.test.mjs",
    "test:routes": "node scripts/check-routes.mjs",
    "tokens:generate": "pnpm --filter @mobtranslate/ui tokens:generate && node scripts/generate-tokens.mjs",
    "tokens:check": "pnpm --filter @mobtranslate/ui tokens:check && node scripts/generate-tokens.mjs --check",
    "examples:generate": "node scripts/generate-examples.mjs",
    "examples:check": "node scripts/generate-examples.mjs --check",
    "test:inputs": "node --test tests/inputs.test.mjs",
    "test:menus": "node --test tests/menus.test.mjs",
    "test:navigation-controls": "node --test tests/navigation-controls.test.mjs",
    "test:destinations": "node --test tests/destinations.test.mjs",
    "test:adaptive-navigation": "node --test tests/adaptive-navigation.test.mjs",
    "test:select": "node --test tests/select.test.mjs",
    "test:autocomplete": "node --test tests/autocomplete.test.mjs",
    "test:combobox": "node --test tests/combobox.test.mjs",
    "test:date-time": "node --test tests/date-time.test.mjs",
    "test:disclosure": "node --test tests/disclosure.test.mjs",
    "test:rating": "node --test tests/rating.test.mjs",
    "test:stepper": "node --test tests/stepper.test.mjs",
    "test:layout-utilities": "node --test tests/layout-utilities.test.mjs",
    "test:avatar": "node --test tests/avatar.test.mjs",
    "test:scroll-area": "node --test tests/scroll-area.test.mjs",
    "test:preview-card": "node --test tests/preview-card.test.mjs",
    "test:table": "node --test tests/table.test.mjs",
    "test:material-patterns": "node --test tests/material-patterns.test.mjs",
    "test:governed-patterns": "node --test tests/governed-patterns.test.mjs",
    "test:learning-offline": "node --test tests/learning-offline.test.mjs",
    "audio:check": "node scripts/generate-audio-fixture.mjs --check",
    "test:token-contract": "node --test tests/token-contract.test.mjs",
    "test:component-specifications": "node --test tests/component-specifications.test.mjs",
    "glossary:check": "node scripts/check-glossary.mjs",
    "test:inclusive-glossary": "node --test tests/inclusive-glossary.test.mjs",
    "test:accessibility": "node scripts/check-accessibility.mjs",
    "audit:api": "node scripts/audit-public-api.mjs",
    "audit:documentation": "node scripts/audit-documentation.mjs",
    "test:audit-repairs": "node --test tests/audit-repairs.test.mjs",
    "api:generate": "node scripts/generate-api-reference.mjs",
    "api:check": "node scripts/generate-api-reference.mjs --check",
    "test:api-reference": "node --test tests/api-reference.test.mjs",
    "api:delivery": "node scripts/check-api-delivery.mjs",
    "test:watches": "node --test tests/watches.test.mjs",
    "test:xr": "node --test tests/xr.test.mjs",
    "alternative-fixture:generate": "node scripts/generate-alternative-fixture.mjs",
    "alternative-fixture:check": "node scripts/generate-alternative-fixture.mjs --check",
    "test:alternative-text": "node --test tests/alternative-text.test.mjs",
    "test:notice-content": "node --test tests/notice-content.test.mjs",
    "test:layout-compositions": "node --test tests/layout-compositions.test.mjs",
    "test:spring-model": "node --test tests/spring-model.test.mjs",
    "test:spring-browser": "node --test tests/spring-browser.test.mjs",
    "test:color-model": "vitest run --config vitest-color.config.mts",
    "color-fixture:check": "node scripts/generate-color-fixture.mjs --check",
    "test:color-browser": "node --test tests/color-browser.test.mjs",
    "test:elevation": "node --test tests/elevation.test.mjs",
    "font-fixture:check": "node scripts/check-font-fixture.mjs",
    "test:typography": "node --test tests/typography.test.mjs",
    "test:header-reflow": "node --test tests/header-reflow.test.mjs",
    "test:shape": "node --test tests/shape.test.mjs",
    "test:iconography": "node --test tests/iconography.test.mjs",
    "test:token-references": "vitest run --config vitest-token.config.mts",
    "test:token-export": "node --test tests/token-export.test.mjs",
    "test:spacing": "node --test tests/spacing.test.mjs",
    "test:interaction-depth": "node --test tests/interaction-depth.test.mjs",
    "test:text-visibility": "node --test tests/text-visibility.test.mjs"
  },
  "dependencies": {
    "@material/material-color-utilities": "0.4.0",
    "@mobtranslate/ui": "workspace:*",
    "next": "^16.2.9",
    "postcss-value-parser": "4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.1",
    "@types/node": "26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "axe-core": "4.12.1",
    "postcss": "8.5.15",
    "tailwindcss": "4.3.1",
    "typescript": "6.0.3"
  }
}
