{
  "name": "@mobtranslate/ui",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/generate-tokens.mjs --check && tsc",
    "dev": "tsc --watch",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --cache --cache-location .cache/eslint/.eslintcache --max-warnings 0",
    "typecheck": "node scripts/generate-tokens.mjs --check && tsc -p tsconfig.json --noEmit",
    "tokens:generate": "node scripts/generate-tokens.mjs",
    "tokens:check": "node scripts/generate-tokens.mjs --check"
  },
  "dependencies": {
    "@base-ui-components/react": "1.0.0-rc.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "postcss": "8.5.15"
  },
  "peerDependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
